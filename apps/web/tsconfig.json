{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/*": [
        "../../packages/ui/components/*"
      ],
      "@/screens/*": [
        "../../packages/ui/screens/*"
      ],
      "@/data/*": [
        "../../packages/ui/data/*"
      ],
      "@/engine/*": [
        "../../packages/ui/engine/*"
      ],
      "@/utils/*": [
        "../../packages/ui/utils/*"
      ],
      "@/hooks/*": [
        "../../packages/ui/hooks/*"
      ],
      "@/styles/*": [
        "../../packages/ui/styles/*"
      ],
      "~/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/ui/types/*.d.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
