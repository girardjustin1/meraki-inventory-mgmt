# Meraki Inventory: environment variables
#
# Copy to .env.local for local development. On Vercel, add them under
# Project > Settings > Environment Variables. Never commit real values.
#
# EVERY variable is optional. With none set the app runs in prototype mode on sample
# data: no sign-in, no database, no email. Each integration switches on when its own
# group of variables is complete (see lib/env.ts).

# ---------------------------------------------------------------- App
# Public origin of the app, no trailing slash. Used for links in emails.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------- Clerk (sign-in)
# Publishable key from Clerk dashboard > API keys (pk_test_... or pk_live_...).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key from the same page (sk_test_... or sk_live_...). Server only.
CLERK_SECRET_KEY=
# Path of the app's own sign-in page. Leave empty to use Clerk's hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Stops Clerk creating a temporary "keyless" development instance when no keys are set.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true

# ---------------------------------------------------------------- Supabase (database)
# Project URL from Supabase dashboard > Project Settings > API (https://<ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser; row-level security applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Bypasses row-level security. Server only: cron and PIN routes.
SUPABASE_SECRET_KEY=
# Older projects: NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are read as fallbacks.

# ---------------------------------------------------------------- Resend (email)
# API key from Resend dashboard > API Keys (re_...). "Sending access" is enough.
RESEND_API_KEY=
# From address on a domain verified in Resend, e.g. Meraki Inventory <inventory@mail.example.com>
RESEND_FROM=
# Optional. Where replies to digests and alerts go.
RESEND_REPLY_TO=
# Optional. Send EVERY email to this one address instead of the real recipients (staging, previews).
EMAIL_REDIRECT_TO=
# Optional. Absolute https URL of a logo image for emails. Unset: a text wordmark is used.
EMAIL_LOGO_URL=

# ---------------------------------------------------------------- Cron
# Random string, 32+ characters (openssl rand -base64 32). Vercel sends it as "Authorization: Bearer ..." to cron routes.
CRON_SECRET=

# ---------------------------------------------------------------- PIN lock
# Random string, 32+ characters (openssl rand -base64 32). Signs the pin_ok cookie. Unset in production = PIN lock off.
PIN_COOKIE_SECRET=
# Optional but recommended. Random string mixed into PIN hashes. Changing it invalidates every PIN.
PIN_PEPPER=
# Optional. Minutes of inactivity before the PIN is asked for again. Default 15.
PIN_IDLE_MINUTES=15
